APP_NAME="MarketScope"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Seoul
APP_URL=http://localhost/market

APP_LOCALE=ko
APP_FALLBACK_LOCALE=ko
APP_FAKER_LOCALE=ko_KR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=market
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@marketscope.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ─── 공공데이터포털 (data.go.kr) ───────────────────────────────
# 마이페이지 > 인증키 발급 후 Decoding 키를 넣으세요.
OPENDATA_SERVICE_KEY=
OPENDATA_TIMEOUT=30
OPENDATA_VERIFY_SSL=false

# ─── 서울 열린데이터광장 (data.seoul.go.kr) ────────────────────
# 로그인 후 [일반 인증키] 1개만 발급받으면 상권분석서비스 전 API 를 쓸 수 있습니다.
# https://data.seoul.go.kr/together/mypage/actKeyMain.do
SEOUL_OPENAPI_KEY=
SEOUL_OPENAPI_URL=http://openapi.seoul.go.kr:8088
SEOUL_OPENAPI_TIMEOUT=30

# ─── 소상공인 상가(상권)정보 (data.go.kr 15012005, 활용신청 필요) ───
# 별도 키를 쓰지 않으면 OPENDATA_SERVICE_KEY 를 그대로 사용합니다.
SBIZ_SERVICE_KEY=

# ─── 지도 (카카오 JavaScript 키) ───────────────────────────────
KAKAO_MAP_JS_KEY=
KAKAO_REST_API_KEY=
VITE_KAKAO_MAP_JS_KEY="${KAKAO_MAP_JS_KEY}"
